{
    "name": "rimba/foundation",
    "description": "The Rimba Foundation provides the minimum set of capabilities required for an organization to operate on the platform.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BIT Ecosystem",
            "email": "bit.ecosystem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "rimba/asas": "^1.4",
        "rimba/bantu": "^1.4",
        "rimba/boleh": "^1.4",
        "rimba/citra": "^1.4",
        "rimba/jalur": "^1.4",
        "rimba/janji": "^1.4",
        "rimba/jawat": "^1.4",
        "rimba/jejak": "^1.4",
        "rimba/kerja": "^1.4",
        "rimba/laras": "^1.4",
        "rimba/orang": "^1.4",
        "rimba/pelan": "^1.4",
        "rimba/pihak": "^1.4",
        "rimba/siapa": "^1.4",
        "rimba/sifat": "^1.4",
        "rimba/tutur": "^1.4",
        "rimba/versi": "^1.4",
        "rimba/waktu": "^1.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rimba\\Foundation\\FoundationServiceProvider",
                "Rimba\\Foundation\\Providers\\AdminPanelProvider",
                "Rimba\\Foundation\\Providers\\LobbyPanelProvider",
                "Rimba\\Foundation\\Providers\\StaffPanelProvider",
                "Rimba\\Foundation\\Providers\\TeamPanelProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Rimba\\Foundation\\": "src/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}